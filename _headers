# Read by Netlify and Cloudflare Pages (other hosts ignore the file).
# The app shell and the service worker must never be served stale, or visitors would not get updates; the built files in
# /assets have the content hash in their name, so they can be kept forever.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
